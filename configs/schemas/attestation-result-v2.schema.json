{
  "$defs": {
    "AttestationResultCoreV2": {
      "additionalProperties": false,
      "properties": {
        "ak_key_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Ak Key Id",
          "type": "string"
        },
        "baseline_id": {
          "title": "Baseline Id",
          "type": "string"
        },
        "baseline_version": {
          "title": "Baseline Version",
          "type": "string"
        },
        "challenge_id": {
          "title": "Challenge Id",
          "type": "string"
        },
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "enrollment_id": {
          "title": "Enrollment Id",
          "type": "string"
        },
        "evaluated_at": {
          "title": "Evaluated At",
          "type": "string"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        },
        "measurement_log_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Measurement Log Digest",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Nonce",
          "type": "string"
        },
        "pcr_bank": {
          "const": "sha256",
          "default": "sha256",
          "title": "Pcr Bank",
          "type": "string"
        },
        "pcr_selection": {
          "items": {
            "type": "integer"
          },
          "title": "Pcr Selection",
          "type": "array"
        },
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "quote_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Digest",
          "type": "string"
        },
        "quote_evidence_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Evidence Digest",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "enum": [
            "passed",
            "passed_with_warning",
            "failed_identity",
            "failed_measurement",
            "stale",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "transport_peer_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transport Peer Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "client_id",
        "enrollment_id",
        "challenge_id",
        "ak_key_id",
        "status",
        "nonce",
        "pcr_selection",
        "quote_digest",
        "quote_evidence_digest",
        "measurement_log_digest",
        "transport_peer_fingerprint",
        "policy_id",
        "policy_version",
        "baseline_id",
        "baseline_version",
        "evaluated_at",
        "expires_at"
      ],
      "title": "AttestationResultCoreV2",
      "type": "object"
    },
    "SignatureBlock": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ECDSA-P256-SHA256",
          "default": "ECDSA-P256-SHA256",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "title": "Key Id",
          "type": "string"
        },
        "trust_level": {
          "enum": [
            "software-development",
            "swtpm",
            "tpm2"
          ],
          "title": "Trust Level",
          "type": "string"
        },
        "value_b64": {
          "title": "Value B64",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "value_b64",
        "trust_level"
      ],
      "title": "SignatureBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "attestation_result",
      "default": "attestation_result",
      "title": "Artifact Type",
      "type": "string"
    },
    "core": {
      "$ref": "#/$defs/AttestationResultCoreV2"
    },
    "core_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Core Digest",
      "type": "string"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/SignatureBlock"
    }
  },
  "required": [
    "result_id",
    "core",
    "core_digest",
    "signature"
  ],
  "title": "AttestationResultV2",
  "type": "object"
}
